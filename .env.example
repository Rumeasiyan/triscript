# ── Next.js (frontend) ───────────────────────────────────────────────────────

# Address the PHONE can reach this app on (used in the QR code).
# Leave empty to use the auto-detected LAN IP address.
# Local example:  http://192.168.1.20:3000
# Production:     https://triscript.example.com
NEXT_PUBLIC_PUBLIC_URL=

# Optional: URL of a TRISCRIPT reader (OCR) service.
# POST multipart (field "image", field "uiLang") → JSON { "fields": { ... } }
# Leave empty to use the built-in DEMO reader (invented TEST values, 30s timeout).
NEXT_PUBLIC_TRISCRIPT_READER_URL=

# ── Go backend (set in the terminal that runs "go run .") ───────────────────

# PostgreSQL connection string.
# Format: postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
# Omit DATABASE_URL entirely to use the in-memory store (no persistence).
DATABASE_URL=postgres://triscript_user:change_me@localhost:5432/triscript_db?sslmode=disable

# URL of the Go backend as seen by the Next.js server process.
# The browser never contacts this URL directly.
GO_API_URL=http://localhost:8080

# Private directory where uploaded photos are stored.
# Must NOT be inside the Next.js public/ folder.
# Default: ./photo_storage  (relative to backend working directory)
PHOTO_STORAGE_DIR=./photo_storage

# How long a pairing session lasts, in seconds (default 300 = 5 minutes).
SESSION_TTL_SECONDS=300

# Optional: allow direct cross-origin requests to the Go backend.
# Not needed in the default proxy setup (Next.js proxies everything).
# Set to the Next.js origin, e.g. http://localhost:3000
CORS_ALLOWED_ORIGIN=

# ── Testing only (never use a production database for tests) ─────────────────

# Connection string for the isolated test database.
# Set before running:  go test ./db/... -v
TEST_DATABASE_URL=postgres://triscript_user:change_me@localhost:5432/triscript_test?sslmode=disable
