# ─────────────────────────────────────────────────────────────
# TRISCRIPT environment variables
# Copy this file to .env.local and fill in the values you need.
# ─────────────────────────────────────────────────────────────

# Address the PHONE can reach this app on (used inside the QR code).
# Leave empty to use the address shown in the computer's browser.
# On a local network, use your computer's LAN address, e.g. http://192.168.1.20:3000
NEXT_PUBLIC_PUBLIC_URL=

# ─── Reader (letter OCR) ──────────────────────────────────────────────────────

# OpenAI API key. When set, the server sends each photo to GPT-4o Vision and
# returns the extracted letter fields. When unset, the built-in DEMO reader
# is used — it returns invented TEST letter values so the full flow works
# without any external service.
OPENAI_API_KEY=

# Optional: URL of a custom TRISCRIPT-compatible reader service.
# Takes priority over OPENAI_API_KEY if set.
# The app POSTs multipart form data (field "image", plus "uiLang") and expects:
#   { "fields": { "subject": { "value": "...", "confidence": 0.93 }, ... } }
# Leave empty to use the built-in reader (OpenAI or demo fallback).
NEXT_PUBLIC_TRISCRIPT_READER_URL=

# Optional: secret key to restrict access to the /api/read endpoint.
# When set, callers must include the header: X-Triscript-Key: <value>
# Leave empty to allow any caller (fine for local/intranet use).
TRISCRIPT_API_KEY=

# ─── Sessions ─────────────────────────────────────────────────────────────────

# How long a pairing code lasts, in seconds (default 300).
SESSION_TTL_SECONDS=300
