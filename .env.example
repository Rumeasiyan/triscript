# Use a long random alphanumeric value; URL-safe characters simplify DATABASE_URL.
POSTGRES_USER=triscript
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-value
POSTGRES_DB=triscript

# Set both URLs to the computer's LAN IPv4 when phones connect over Wi-Fi.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEB_URL=http://localhost:3000
